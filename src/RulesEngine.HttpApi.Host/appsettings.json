{
  "App": {
    "SelfUrl": "https://localhost:44396",
    "AngularUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.RulesEngine.com,http://localhost:4200,",
    "RedirectAllowedUrls": "http://localhost:4200,",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=(LocalDb)\\MSSQLLocalDB;Database=RulesEngine;Trusted_Connection=True;TrustServerCertificate=true"

  },
  "seqURL": "http://seq-service.seq.svc.cluster.local:5341",

  "AuthServer": {
    "Authority": "https://localhost:44396",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "RulesEngine_Swagger",
    "CertificatePassPhrase": "46213fe8-ba8f-4ae7-8fa6-8e2233c6d797"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "bTKObS9orE4aJI51"
  }
}